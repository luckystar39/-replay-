@echo off
chcp 65001 >nul
rem ============================================================
rem  双击本文件 = 用【旧的 WinForms 界面】启动（退路）
rem
rem  什么时候用得着：新界面出了怪问题、或者要跑那些还依赖原生窗口句柄的老验证脚本。
rem  旧界面在同一个 exe 里，加 --old 就切过去，行为和切换之前一模一样。
rem
rem  想彻底用回旧版程序本体：RepRecorder-源码\RepRecorder.exe（那份是切换前的完整快照）
rem ============================================================
start "" "%~dp0RepRecorderWPF.exe" --old %*
exit
